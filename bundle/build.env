# Build configuration for official builds. Committed so builds are reproducible.
# Override values locally in .env (ignored by Gradle builds, which pass --reproducible).

VALENCED_DISCORD_SERVER_URL=https://discord.com/invite/ddcQf3s2Uq
VALENCED_SOURCE_REPOSITORY_URL=https://github.com/Valenced/valenced-xposed
VALENCED_LICENSE_URL=https://raw.githubusercontent.com/Valenced/valenced-xposed/main/bundle/LICENSE

# Required while any bundled plugin is a stub with a default source.
VALENCED_DEFAULT_PLUGIN_REPOSITORY_URL=

# Optional
VALENCED_DONATE_URL=
